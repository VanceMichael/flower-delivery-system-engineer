{
  "name": "flower-delivery-system",
  "version": "1.0.0",
  "private": true,
  "description": "鲜花配送管理系统 - Monorepo",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "lint": "npm run lint --workspace=backend --workspace=frontend",
    "test": "npm run test --workspace=backend --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2"
  },
  "lint-staged": {
    "backend/src/**/*.js": [
      "eslint --fix"
    ],
    "frontend/src/**/*.{js,vue}": [
      "eslint --fix"
    ],
    "*.{json,md,css,less}": [
      "prettier --write"
    ]
  }
}
